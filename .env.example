# SeoBoy – lokale Umgebung.
# Diese Datei nach .env kopieren und anpassen. .env wird nicht versioniert.

# Standard-Konfiguration für alle Befehle (relativ zum Arbeitsverzeichnis).
SEOBOY_CONFIG=./seoboy.yaml

# Optional: Standardverzeichnis für den GSC-Import bei "seoboy run".
# Wird bei --resume und bei explizit gesetztem --gsc-dir nicht verwendet.
# SEOBOY_GSC_DIR=./imports/gsc

# Optional: alternatives Env-File. Muss vor dem SeoBoy-Aufruf gesetzt sein.
# SEOBOY_ENV_FILE=./.env.local
