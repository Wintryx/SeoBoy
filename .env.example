# SeoBoy – lokale Umgebung.
# Diese Datei nach .env kopieren und anpassen. .env wird nicht versioniert.

# Standard-Konfiguration für alle Befehle (relativ zum Arbeitsverzeichnis).
SEOBOY_CONFIG=./seoboy.yaml

# Optional: Standardverzeichnis für den GSC-Import bei "seoboy run".
# Wird bei --resume und bei explizit gesetztem --gsc-dir nicht verwendet.
# SEOBOY_GSC_DIR=./imports/gsc

# Optional: automatischer GSC-Abruf bei "seoboy run".
# Unterstützt OAuth-Refresh-Token und Service-Account-JSON.
# SEOBOY_GSC_CREDENTIALS=./secrets/google-service-account.json
# Standard ist die Start-URL mit abschließendem Slash.
# SEOBOY_GSC_PROPERTY=https://example.de/
# Optionaler Pfad für den interaktiven OAuth-Token-Store.
# SEOBOY_GSC_TOKEN_STORE=./secrets/gsc-oauth.json

# Optional: Pfad zu openssl, falls die Service-Account-Signatur nicht über
# cryptography, sondern über OpenSSL erfolgen soll.
# SEOBOY_OPENSSL=C:\Program Files\Git\usr\bin\openssl.exe

# Optional: API-Key für PageSpeed Insights/Lighthouse und CrUX.
# SEOBOY_PSI_API_KEY=...

# Optional: DeepSeek-API-Key für budgetierte GEO-Antwortstichproben.
# SEOBOY_GEO_API_KEY=...

# KI-Qualität und Effizienz (CLI-Optionen haben Vorrang).
# SEOBOY_GEO_MODEL=deepseek-flash
# SEOBOY_GEO_THINKING=enabled
# SEOBOY_GEO_REASONING_EFFORT=high
# SEOBOY_GEO_WEB_SEARCH=false
# SEOBOY_AI_REVIEW_MODEL=deepseek-flash
# SEOBOY_AI_REVIEW_THINKING=disabled
# SEOBOY_AI_REVIEW_REASONING_EFFORT=none

# Optional: alternatives Env-File. Muss vor dem SeoBoy-Aufruf gesetzt sein.
# SEOBOY_ENV_FILE=./.env.local
